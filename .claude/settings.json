{
  "permissions": {
    "ask": [
      "Bash(git commit *)",
      "Bash(git --no-pager commit *)",
      "Bash(git push *)",
      "Bash(git --no-pager push *)",
      "Bash(git tag *)",
      "Bash(git --no-pager tag *)",
      "Agent(smartpi-fable-consult)"
    ]
  },
  "hooks": {
    "PreCompact": [
      {
        "matcher": "auto",
        "hooks": [
          {
            "type": "prompt",
            "prompt": "on va compact le contexte. Sauvegarde dans la mémoire ce qui est necessaire",
            "timeout": 120
          }
        ]
      }
    ]
  }
}